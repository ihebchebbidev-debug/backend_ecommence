# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# ── Server ────────────────────────────────────────────────────────────
PORT=8000
PUBLIC_URL=http://localhost:8000
NODE_ENV=development

# ── Auth (replaces Supabase GoTrue) ───────────────────────────────────
# JWT_SECRET signs access tokens. ANON_KEY / SERVICE_ROLE_KEY are JWTs
# signed with the same secret, carrying { role: 'anon' | 'service_role' }.
# Required in production; in development a random per-boot secret is used
# when this is empty. Generate keys with: node scripts/make-keys.js
JWT_SECRET=change-me-to-a-64-char-random-string
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Email (password reset + sign-up confirmation) ─────────────────────
# Set ONE of RESEND_API_KEY or EMAIL_WEBHOOK_URL. Required in production;
# without it the server logs the message instead of sending it (dev only).
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_DIR=./storage-data
# Buckets created on boot; any other bucket is created by its first upload.
STORAGE_BUCKETS=platform-assets,theme-previews,uploads
# Buckets only platform admins may write to.
STORAGE_ADMIN_BUCKETS=platform-assets,theme-previews
MAX_UPLOAD_BYTES=52428800

# ── Realtime ──────────────────────────────────────────────────────────
# Tables that publish live changes over /realtime/v1/websocket.
REALTIME_TABLES=orders

# ── Encryption for provider credentials (32-byte key, base64 or hex) ──
DELIVERY_CREDENTIALS_ENCRYPTION_KEY=
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# ── External providers (only needed by the matching function) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Either name is accepted by the meta-capi function.
META_CAPI_ACCESS_TOKEN=
# Payment gateway fallbacks when payment_gateway_settings has no key.
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# ── Development only ──────────────────────────────────────────────────
# Returns the OTP code to super admins when no SMS provider is configured.
# Ignored when NODE_ENV=production.
DEV_OTP_ALLOWED=false
